# Copy to .env.local (gitignored). Values for the LOCAL stack come from `supabase status`.
# When a cloud project exists, swap these for that project's URL and keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (anon) key — shipped to the browser; RLS is the gatekeeper.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (service_role) key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional. Absolute origin used in links we hand out (staff invite URLs).
# Falls back to the incoming request's host when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
