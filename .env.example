# Copy to .env.local (gitignored). Values for the LOCAL stack come from `supabase status`.
# For the cloud project, see DEPLOYMENT.md §3.5 — the same four variables are set
# in Vercel (Production and Preview), never committed here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (anon) key — shipped to the browser; RLS is the gatekeeper.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (service_role) key — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Absolute origin used in links we hand out (staff and tenant invite URLs).
# Set it in Vercel Production to the production domain. Leave it UNSET on preview
# deployments and locally, so the origin is derived from the incoming request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Presence switches notifications off the console-only path, but real
# sending is still TODO(resend) — see src/lib/notifications.ts. Leave unset.
# RESEND_API_KEY=

# Public contact channels for the homepage. Leave unset and the channel is not
# shown (nothing is invented). TODO(owner): set both before launch.
# NEXT_PUBLIC_CONTACT_WHATSAPP=2348000000000   # digits only, country code first
# NEXT_PUBLIC_CONTACT_EMAIL=
# Optional salt for hashing IPs in the contact-form rate limiter (never stored raw).
# CONTACT_RATE_SALT=
